{
  "$comment": "教學用虛構品牌規範。ChatGPT Codex 教學講義示範資料。",
  "brand": {
    "name_zh": "麥禾烘焙",
    "name_en": "MAIHO Bakery",
    "tagline_zh": "當日現烤，當日售完",
    "tagline_en": "Baked today. Gone today.",
    "founded": 2019,
    "positioning": "中價位精緻烘焙，強調當日現做與在地食材",
    "version": "3.2",
    "last_updated": "2026-08-20"
  },

  "colors": {
    "primary": {
      "wheat_gold": {
        "hex": "#C8912F",
        "rgb": [200, 145, 47],
        "usage": "主要品牌色。logo、主標題、CTA 按鈕",
        "min_contrast_partner": "#FFFFFF"
      },
      "kiln_brown": {
        "hex": "#4A3428",
        "rgb": [74, 52, 40],
        "usage": "內文、次標題、深色背景",
        "min_contrast_partner": "#F7F1E6"
      }
    },
    "secondary": {
      "cream": {
        "hex": "#F7F1E6",
        "rgb": [247, 241, 230],
        "usage": "主要背景色"
      },
      "sea_salt": {
        "hex": "#E8E2D6",
        "rgb": [232, 226, 214],
        "usage": "區塊分隔、卡片背景"
      },
      "leaf_green": {
        "hex": "#6B8E5A",
        "rgb": [107, 142, 90],
        "usage": "在地食材相關標示、產地標章"
      }
    },
    "seasonal": {
      "$comment": "季節性強調色，每季更換。僅用於該季新品，不可用於常態品項。",
      "autumn_2026": {
        "chestnut": {
          "hex": "#8B5E3C",
          "rgb": [139, 94, 60],
          "usage": "2026 秋季新品專用強調色",
          "valid_until": "2026-11-30"
        }
      }
    },
    "forbidden": {
      "$comment": "明確禁用的顏色，違反品牌規範",
      "pure_black": {
        "hex": "#000000",
        "reason": "過於銳利，與品牌溫暖調性衝突。請改用 kiln_brown #4A3428"
      },
      "pure_white_background": {
        "hex": "#FFFFFF",
        "reason": "僅可用於 logo 留白區與 CTA 文字，不可作為大面積背景。背景請用 cream #F7F1E6"
      },
      "neon_any": {
        "reason": "任何螢光色系均不符品牌調性"
      }
    }
  },

  "typography": {
    "zh": {
      "heading": {
        "family": "思源宋體 Noto Serif TC",
        "weight": 700,
        "usage": "主標題、產品名稱"
      },
      "body": {
        "family": "思源黑體 Noto Sans TC",
        "weight": 400,
        "min_size_px": 14,
        "usage": "內文、說明文字"
      }
    },
    "en": {
      "heading": { "family": "Playfair Display", "weight": 700 },
      "body": { "family": "Inter", "weight": 400 }
    },
    "rules": [
      "中英文混排時，英文使用對應的英文字體，不可用中文字體渲染英文",
      "同一版面中字體層級不超過 3 級",
      "內文字級不得小於 14px（印刷品不得小於 9pt）"
    ]
  },

  "logo": {
    "clear_space": "logo 四周留白不得小於 logo 高度的 0.5 倍",
    "min_width_px": 80,
    "variants": ["full_color", "kiln_brown_mono", "cream_reverse"],
    "forbidden_usage": [
      "不可旋轉、傾斜或加陰影",
      "不可放置在對比不足的背景上",
      "不可更改 logo 內部的字距或比例",
      "不可用季節性強調色渲染 logo"
    ]
  },

  "photography": {
    "style": "自然光、暖色調、淺景深",
    "angles": ["俯視 45 度", "平視特寫"],
    "forbidden": [
      "不使用強烈的人工打光",
      "不使用冷色調濾鏡",
      "商品照中不出現人物臉部",
      "不使用非本店商品的示意圖"
    ],
    "background": "木質桌面、亞麻布、素色陶盤"
  },

  "accessibility": {
    "min_contrast_ratio_normal_text": 4.5,
    "min_contrast_ratio_large_text": 3.0,
    "$comment": "依 WCAG 2.1 AA。wheat_gold #C8912F 在 cream #F7F1E6 背景上的對比度不足，不可作為內文色。"
  },

  "social": {
    "instagram": {
      "post_size": "1080x1080",
      "story_size": "1080x1920",
      "caption_max_chars": 2200,
      "recommended_caption_chars": 300,
      "hashtag_count": { "min": 3, "max": 8 },
      "required_hashtags": ["#麥禾烘焙", "#當日現烤"]
    }
  },

  "tone_of_voice": {
    "do": [
      "描述具體的口感、香氣與食材產地",
      "誠實說明售完時間與限量狀況",
      "用「我們」而非「本店」"
    ],
    "dont": [
      "不使用「最好吃」「第一名」等無法佐證的最高級形容",
      "不宣稱任何健康或療效功能",
      "不使用製造焦慮的行銷語言（「錯過再等一年」）",
      "不比較或影射競品"
    ]
  }
}
